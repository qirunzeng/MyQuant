#include <windows.h>
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/icons/MyQuant.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "qirunzeng\0"
   VALUE "FileDescription", "MyQuant desktop research and review\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductName", "MyQuant\0"
   VALUE "OriginalFilename", "MyQuant.exe\0"
   VALUE "LegalCopyright", "Copyright 2026 qirunzeng. All rights reserved.\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
